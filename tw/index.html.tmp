/* ================================================================
   蝚?2 ?典?嚗?喉?Web Speech API嚗??單?嚗ebAudio嚗?================================================================ */
let soundOn = localStorage.getItem('zk-sound')!=='0';
let pickedVoice=null, pendingUtter=null;

function loadVoices(){
  if(!('speechSynthesis' in window)){ document.getElementById('voiceWarn').style.display='inline-block'; return; }
  const all=speechSynthesis.getVoices();
  const zh=all.filter(v=>v.lang && v.lang.toLowerCase().replace('_','-').startsWith('zh'));
  const sel=document.getElementById('voiceSel');
  sel.innerHTML = zh.map((v,i)=>`<option value="${i}">${v.name}嚗?{v.lang}嚗?/option>`).join('') || '<option value="-1">嚗銝剜?隤嚗?/option>';
  if(!zh.length){ document.getElementById('voiceWarn').style.display='inline-block'; pickedVoice=null; return; }
  document.getElementById('voiceWarn').style.display='none';
  const saved=localStorage.getItem('zk-voice');
  let idx=zh.findIndex(v=>v.name===saved);
  if(idx<0){ // ?芸???憟賜?嚗????喳??    const score=v=>{
      const n=v.name.toLowerCase(), l=v.lang.toLowerCase();
      let s=0;
      if(l.includes('tw')) s+=100;
      if(/hsiaochen|hsiaoyu|yating|hanhan|zhiwei/.test(n)) s+=50;
      if(n.includes('natural')||n.includes('online')) s+=20;
      if(n.includes('google')) s+=10;
      return s;
    };
    idx=zh.reduce((b,v,i)=>score(v)>score(zh[b])?i:b,0);
  }
  sel.value=String(idx); pickedVoice=zh[idx];
  sel.onchange=()=>{ pickedVoice=zh[Number(sel.value)]||null;
    if(pickedVoice) localStorage.setItem('zk-voice',pickedVoice.name);
    sel.blur(); speak('雿末'); };
}
function speak(text,rate){
  if(!soundOn || !text || !('speechSynthesis' in window)) return;
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  if(pickedVoice) u.voice=pickedVoice;
  u.lang=pickedVoice?pickedVoice.lang:'zh-TW';
  u.rate=rate||0.85;
  pendingUtter=u;
  setTimeout(()=>{ if(pendingUtter===u) speechSynthesis.speak(u); },0);
}

let actx=null;
function tone(freq,dur,type,vol){
  if(!soundOn) return;
  try{
    actx=actx||new (window.AudioContext||window.webkitAudioContext)();
    const o=actx.createOscillator(), g=actx.createGain();
    o.type=type; o.frequency.value=freq;
    g.gain.setValueAtTime(vol,actx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001,actx.currentTime+dur);
    o.connect(g); g.connect(actx.destination);
    o.start(); o.stop(actx.currentTime+dur);
  }catch(e){}
}
const ding =()=>tone(880,.12,'sine',.08);
const buzz =()=>tone(160,.15,'square',.05);
const click=()=>tone(520,.05,'triangle',.06);

/* ================================================================
   蝚?3 ?典?嚗釣?????潮 頧?
================================================================ */
function applyToneMark(base,t){
  if(!t || t===5 || base.includes('礙')) return base;
  let idx=-1;
  for(const ch of ['a','e']){ const i=base.indexOf(ch); if(i>-1){idx=i;break;} }
  if(idx<0){ const i=base.indexOf('o'); if(i>-1) idx=i; }
  if(idx<0){ for(let i=base.length-1;i>=0;i--){ if('iu羹'.includes(base[i])){idx=i;break;} } }
  if(idx<0) return base;
  const row=TONED[base[idx]];
  return row? base.slice(0,idx)+row[t]+base.slice(idx+1) : base;
}
function toPinyin(syms,t){
  let initial='', rest=syms.slice();
  if(rest.length && INITIALS[rest[0]]) initial=rest.shift();
  const finalStr=rest.join('');
  let base;
  if(!finalStr){
    if(!initial) return '';
    const ip=INITIALS[initial];
    if(['zh','ch','sh','r','z','c','s'].includes(ip)) base=ip+'i';
    else return ip; // ?芣??脫?嚗?銝??喟?
  }else{
    const f=FINALS[finalStr];
    if(!f) return '嚗?;
    if(!initial) base=f[0];
    else{
      let ff=f[1]; const ip=INITIALS[initial];
      if(['j','q','x'].includes(ip)) ff=ff.replace('羹','u');
      base=ip+ff;
    }
  }
  return applyToneMark(base,t);
}

/* ================================================================
   蝚?4 ?典?嚗??祇?歹??怠靘?+ 暺?嚗?================================================================ */
const ROWS=[
  ['Digit1','Digit2','Digit3','Digit4','Digit5','Digit6','Digit7','Digit8','Digit9','Digit0','Minus','Equal'],
  ['KeyQ','KeyW','KeyE','KeyR','KeyT','KeyY','KeyU','KeyI','KeyO','KeyP'],
  ['KeyA','KeyS','KeyD','KeyF','KeyG','KeyH','KeyJ','KeyK','KeyL','Semicolon'],
  ['KeyZ','KeyX','KeyC','KeyV','KeyB','KeyN','KeyM','Comma','Period','Slash'],
];
function qlabel(code){
  if(code.startsWith('Digit')) return code.slice(5);
  if(code.startsWith('Key'))   return code.slice(3);
  return {Minus:'-',Equal:'=',Semicolon:';',Comma:',',Period:'.',Slash:'/'}[code]||'';
}
function keyHTML(code){
  const s=CODE2SYM[code], q=qlabel(code);
  if(!s) return `<div class="key ghost"><span class="kq">${q}</span></div>`;
  const cat={initial:'i',medial:'m',final:'f',tone:'t'}[s.group];
  const main = s.group==='tone' ? s.mark : s.z;
  const sub  = s.group==='tone' ? s.name : s.p;
  return `<div class="key cat-${cat}" data-code="${code}">
    <span class="kq">${q}</span><span class="kz">${main}</span><span class="kp">${sub}</span></div>`;
}
function buildKeyboard(el){
  el.classList.add('keyboard');
  const spaceLabel = window.matchMedia('(max-width:720px)').matches
    ? '蝛箇?蛛?銝??
    : '蝛箇?蛛?銝?莎?摰???嚗?;
  el.innerHTML =
    ROWS.map((r,i)=>`<div class="krow r${i}">`+r.map(keyHTML).join('')+'</div>').join('') +
    `<div class="krow rs"><div class="key space cat-t" data-code="Space"><span class="kz">${spaceLabel}</span></div></div>`;
  el.addEventListener('click',ev=>{
    const k=ev.target.closest('.key[data-code]');
    if(k) handleCode(k.dataset.code);
  });
}
function flashKey(el,code,cls,ms){
  const k=el.querySelector(`.key[data-code="${code}"]`);
  if(!k) return;
  k.classList.add(cls);
  setTimeout(()=>k.classList.remove(cls),ms||220);
}

/* ================================================================
   蝚?5 ?典?嚗???嚗??扯”嚗?================================================================ */
function cardHTML(s){
  const isTone=s.group==='tone';
  const cat={initial:'i',medial:'m',final:'f',tone:'t'}[s.group];
  const big=isTone?(s.mark||'?'):s.z;
  const pin=s.pAlt?`${s.p}??{s.pAlt}`:s.p;
  return `<div class="card cat-${cat}" data-tts="${s.tts}">
    <span class="spk">??</span>
    <div class="cz">${big}</div>
    <div class="cp">${isTone? s.name+'?'+s.p : pin}</div>
    <kbd class="ck">${s.key}</kbd>
    <div class="cex" data-w="${s.exW}">靘?${s.exW}??{s.exZ}??{s.exP}</div>
  </div>`;
}
function buildChart(){
  const box=document.getElementById('chartCols');
  let html='';
  for(const c of COLUMNS){
    html+=`<div class="colsec">
      <div class="colhead"><h3>${c.t}</h3><span class="ckeys">?萎?嚗?{c.keys}</span><span class="ccat">${c.cat}${c.note?'??+c.note:''}</span></div>
      <div class="cards">${c.zs.map(z=>cardHTML(Z2SYM[z])).join('')}</div></div>`;
  }
  html+=`<div class="colsec">
    <div class="colhead"><h3>?脰矽</h3><span class="ckeys">?萎?嚗征?賡????????</span><span class="ccat">銝?脖?璅?嚗 ?? 蝷箇?嚗直暻駁收蝵萄?嚗?/span></div>
    <div class="cards">${TONES.map(cardHTML).join('')}</div></div>`;
  box.innerHTML=html;
  box.addEventListener('click',ev=>{
    const ex=ev.target.closest('.cex');
    if(ex){ speak(ex.dataset.w); return; }
    const card=ev.target.closest('.card');
    if(card){
      speak(card.dataset.tts);
      card.classList.remove('pulse'); void card.offsetWidth; card.classList.add('pulse');
    }
  });
}

/* ================================================================
   蝚?6 ?典?嚗???嚗?摮毀蝧?
================================================================ */
const typing={buf:[],line:[],ti:0,progress:0,hint:localStorage.getItem('zk-hint')!=='0',warned:false};
const lineEl=()=>document.getElementById('line');

function sylZhuyin(syms,t){
  const tn=TONES[t-1];
  return (t===5?'?':'')+syms.join('')+((t>=2&&t<=4)?tn.mark:'');
}
function renderLine(){
  const chips=typing.line.map(s=>
    `<div class="syl"><div class="sz">${sylZhuyin(s.syms,s.tone)}</div><div class="sp">${s.py||'&nbsp;'}</div></div>`).join('');
  const cur=typing.buf.length?
    `<div class="syl building"><div class="sz">${typing.buf.join('')}</div><div class="sp">???脰矽?菊?/div></div>`:'';
  const el=lineEl();
  el.innerHTML=(chips+cur)||`<div class="line-empty">?湔?脤?斗???嚗?kbd>S</kbd>嚗?嚗? <kbd>U</kbd>嚗嚗? <kbd>3</kbd>嚗?撠望??箝??弄?n? 雿?/div>`;
  el.scrollLeft=el.scrollWidth;
}
function sylHintHTML(s,ok){
  const parts=s.k.map(z=>`<span class="hz">${z}${typing.hint?`<kbd>${Z2SYM[z].key}</kbd>`:''}</span>`).join('');
  const tn=TONES[s.t-1];
  const tmark=tn.mark||'?';
  return `<span class="hsyl${ok?' ok':''}">${parts}<span class="hz ht">${tmark}${typing.hint?`<kbd>${tn.key}</kbd>`:''}</span></span>`;
}
function renderTarget(done){
  const t=WORDS[typing.ti];
  document.getElementById('target').innerHTML=`<div class="tg${done?' done':''}">
    <div class="tg-label">頝?????/div>
    <div class="tg-word" id="tgWord" title="暺??賜??>${t.w}</div>
    <div class="tg-syls">${t.s.map((s,i)=>sylHintHTML(s,i<typing.progress)).join('')}</div>
    <div class="tg-btns">
      <button id="tgSpeak">?? ?訾?甈?/button>
      <button id="tgNext">??????/button>
      <button id="tgHint">${typing.hint?'?梯?':'憿舐內'}??內</button>
      <button id="tgClear">皜征???</button>
    </div></div>`;
  document.getElementById('tgWord').onclick=()=>speak(t.w);
  document.getElementById('tgSpeak').onclick=e=>{speak(t.w);e.target.blur();};
  document.getElementById('tgNext').onclick=e=>{nextWord();e.target.blur();};
  document.getElementById('tgHint').onclick=e=>{
    typing.hint=!typing.hint; localStorage.setItem('zk-hint',typing.hint?'1':'0');
    renderTarget(); e.target.blur(); };
  document.getElementById('tgClear').onclick=e=>{
    typing.line=[]; typing.buf=[]; typing.progress=0; renderLine(); renderTarget(); e.target.blur(); };
}
function nextWord(){
  typing.ti=(typing.ti+1)%WORDS.length;
  typing.progress=0;
  renderTarget();
}
function recomputeProgress(){
  const t=WORDS[typing.ti]; let p=0;
  const L=typing.line;
  for(let n=Math.min(t.s.length,L.length); n>0; n--){
    let ok=true;
    for(let i=0;i<n;i++){
      const a=L[L.length-n+i], b=t.s[i];
      if(a.syms.join('')!==b.k.join('')||a.tone!==b.t){ok=false;break;}
    }
    if(ok){p=n;break;}
  }
  typing.progress=p;
}
function typeSym(sym){
  if(sym.group==='tone'){
    if(!typing.buf.length){
      const el=lineEl(); el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
      buzz();
      if(!typing.warned){ toast('??瘜券蝚西?嚗?敺??隤輸嚗征?踝?銝?莎?'); typing.warned=true; }
      return;
    }
    const syl={syms:typing.buf.slice(),tone:sym.t,
               py:toPinyin(typing.buf,sym.t),base:toPinyin(typing.buf,0)};
    typing.line.push(syl); typing.buf=[];
    click(); renderLine();
    const prev=typing.progress;
    recomputeProgress();
    const t=WORDS[typing.ti];
    if(typing.progress===t.s.length){
      renderTarget(true);
      toast('?? 憭芣?鈭????+t.w+'??);
      speak(t.w);
      setTimeout(nextWord,1600);
    }else{
      if(typing.progress>prev && typing.progress>0) speak(t.w[typing.progress-1]);
      renderTarget();
    }
  }else{
    if(typing.buf.length>=3){
      const el=lineEl(); el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
      buzz(); toast('??憭鈭????脰矽?萄???嚗征?踝?銝?莎?');
      return;
    }
    typing.buf.push(sym.z);
    speak(sym.tts);
    renderLine();
  }
}

// ??摮??摰寞?亙?箔?嚗??蝭??SYL_CHARS ?曉??喳?嚗銝撠梢?瘜券??
function speakLine(slow){
  if(!typing.line.length){ toast('????蝛箇?嚗??嗾????); return; }
  const parts=typing.line.map(s=>{
    const entry=SYL_CHARS[s.base];
    const ch=entry? entry[s.tone-1] : null;
    return (ch && ch!=='??)? ch : sylZhuyin(s.syms,s.tone);
  });
  speak(slow? parts.join('嚗?) : parts.join(''), slow? 0.55 : 0.8);
}

/* ================================================================
   蝚?7 ?典?嚗???嚗雿葫撽?
================================================================ */
const drill={mode:'z2k',scope:'all',cur:null,last:null,score:0,att:0,streak:0,
             best:Number(localStorage.getItem('zk-best')||0),misses:0};
function drillPool(){
  if(drill.scope==='ini')  return SYMBOLS.filter(s=>s.group==='initial');
  if(drill.scope==='fin')  return SYMBOLS.filter(s=>s.group!=='initial');
  if(drill.scope==='tone') return TONES;
  return SYMBOLS.concat(TONES);
}
function drillStats(){
  document.getElementById('dScore').textContent=drill.score;
  document.getElementById('dAtt').textContent=drill.att;
  document.getElementById('dAcc').textContent=drill.att?Math.round(drill.score/drill.att*100)+'%':'??;
  document.getElementById('dStreak').textContent=drill.streak;
  document.getElementById('dBest').textContent=drill.best;
}
function renderPrompt(){
  const c=drill.cur, el=document.getElementById('dPrompt');
  if(!c){ el.innerHTML=''; return; }
  if(drill.mode==='listen'){
    el.innerHTML=`<button class="dplay" id="dPlay" title="?銝甈?>??</button><div class="dsub">?賜?喉??撠??嚗????嚗?/div>`;
    document.getElementById('dPlay').onclick=e=>{speak(c.tts);e.target.blur();};
    return;
  }
  if(c.group==='tone'){
    const big=drill.mode==='p2k'?c.p:(c.mark||'銝??);
    const sub=drill.mode==='p2k'?'??脰矽嚗 a 蝷箇?嚗??撠??脰矽??:c.name+(c.t===1?'嚗釣?喃?璅?嚗?:'');
    el.innerHTML=`<div class="dbig">${big}</div><div class="dsub">${sub}</div>`;
  }else{
    const big=drill.mode==='p2k'?(c.pAlt?`${c.p}??{c.pAlt}`:c.p):c.z;
    const sub=drill.mode==='p2k'?'??潮嚗??箏??釣?喟???:'??釣?喟泵????;
    el.innerHTML=`<div class="dbig">${big}</div><div class="dsub">${sub}</div>`;
  }
}
function nextQ(){
  const kb=document.getElementById('kb-drill');
  kb.querySelectorAll('.hintkey,.good,.bad').forEach(k=>k.classList.remove('hintkey','good','bad'));
  const pool=drillPool();
  let c;
  do{ c=pool[Math.floor(Math.random()*pool.length)]; }while(pool.length>1 && c===drill.last);
  drill.cur=c; drill.last=c; drill.misses=0;
  renderPrompt();
  if(drill.mode==='listen') speak(c.tts);
}
function drillAnswer(sym){
  const c=drill.cur; if(!c) return;
  const kb=document.getElementById('kb-drill');
  if(sym.code===c.code){
    drill.cur=null;
    drill.score++; drill.att++; drill.streak++;
    if(drill.streak>drill.best){ drill.best=drill.streak; localStorage.setItem('zk-best',String(drill.best)); }
    flashKey(kb,sym.code,'good',400);
    ding();
    if(drill.mode!=='listen') speak(c.tts);
    drillStats();
    setTimeout(nextQ,430);
  }else{
    drill.att++; drill.streak=0; drill.misses++;
    flashKey(kb,sym.code,'bad',400);
    const p=document.getElementById('dPrompt');
    p.classList.remove('shake'); void p.offsetWidth; p.classList.add('shake');
    buzz();
    if(drill.misses>=2){
      const k=kb.querySelector(`.key[data-code="${c.code}"]`);
      if(k) k.classList.add('hintkey');
    }
    drillStats();
  }
}
function drillReset(){
  drill.score=0; drill.att=0; drill.streak=0; drill.misses=0; drill.cur=null; drill.last=null;
  drillStats(); nextQ();
}

/* ================================================================
   蝚?8 ?典?嚗??菔楝??+ ???? + ??
================================================================ */
const state={tab:'chart'};
const KB={};

function handleCode(code){
  // ?寞???  if(state.tab==='type'){
    if(code==='Backspace'){
      if(typing.buf.length) typing.buf.pop();
      else typing.line.pop();
      recomputeProgress(); renderLine(); renderTarget();
      return true;
    }
    if(code==='Escape'){
      typing.buf=[]; typing.line=[]; typing.progress=0;
      renderLine(); renderTarget();
      return true;
    }
    if(code==='Enter'||code==='NumpadEnter'){ speakLine(false); return true; }
  }
  if(state.tab==='drill' && code==='Escape'){ drill.streak=0; drillStats(); nextQ(); return true; }

  const sym=CODE2SYM[code];
  if(!sym) return false;
  const kb=KB[state.tab];
  if(kb) flashKey(kb,code,'active',150);
  if(state.tab==='chart'){ speak(sym.tts); }
  else if(state.tab==='type'){ typeSym(sym); }
  else{ drillAnswer(sym); }
  return true;
}

document.addEventListener('keydown',e=>{
  if(e.ctrlKey||e.altKey||e.metaKey||e.repeat) return;
  const t=e.target;
  if(t && t.closest && t.closest('select,input,textarea')) return;
  if(e.isComposing||e.keyCode===229){
    const w=document.getElementById('imeWarn');
    if(w){ w.classList.add('urgent'); }
    toast('???菜葫?唬葉?撓?交?嚗???Win嚗征?賡 ??望?頛詨瘜?蝺渡?');
    return;
  }
  if(handleCode(e.code)) e.preventDefault();
});

let toastTimer=null;
function toast(msg){
  const el=document.getElementById('toast');
  el.textContent=msg; el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('show'),2400);
}

function switchTab(name){
  state.tab=name;
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.tab===name));
  document.querySelectorAll('section[id^="tab-"]').forEach(s=>s.classList.toggle('show',s.id==='tab-'+name));
  if(name==='drill'&&!drill.cur) nextQ();
  if(document.activeElement&&document.activeElement.blur) document.activeElement.blur();
}

function init(){
  buildKeyboard(document.getElementById('kb-chart'));
  buildKeyboard(document.getElementById('kb-type'));
  buildKeyboard(document.getElementById('kb-drill'));
  KB.chart=document.getElementById('kb-chart');
  KB.type=document.getElementById('kb-type');
  KB.drill=document.getElementById('kb-drill');

  buildChart();
  renderTarget();
  renderLine();
  drillStats();

  document.querySelectorAll('.tabs button').forEach(b=>{
    b.addEventListener('click',()=>{switchTab(b.dataset.tab); b.blur();});
  });

  const sb=document.getElementById('soundBtn');
  const paint=()=>{sb.textContent=soundOn?'?? ?單???:'?? ?單???;};
  paint();
  sb.addEventListener('click',()=>{
    soundOn=!soundOn; localStorage.setItem('zk-sound',soundOn?'1':'0');
    paint(); sb.blur();
    if(soundOn) speak('雿末');
    else if('speechSynthesis' in window) speechSynthesis.cancel();
  });

  document.getElementById('lineSpeak').addEventListener('click',e=>{speakLine(false); e.target.blur();});
  document.getElementById('lineSpeakSlow').addEventListener('click',e=>{speakLine(true); e.target.blur();});

  document.getElementById('dMode').addEventListener('change',e=>{drill.mode=e.target.value; e.target.blur(); drillReset();});
  document.getElementById('dScope').addEventListener('change',e=>{drill.scope=e.target.value; e.target.blur(); drillReset();});
  document.getElementById('dBlind').addEventListener('change',e=>{
    document.getElementById('kb-drill').classList.toggle('blind',e.target.checked);
    e.target.blur();
  });

  if('speechSynthesis' in window){
    loadVoices();
    speechSynthesis.onvoiceschanged=loadVoices;
  }else{
    document.getElementById('voiceWarn').style.display='inline-block';
  }
}
init();
</script>
</body>
</html>
